{
  "name": "dead-slow-harbor-trials",
  "version": "6.0.0",
  "private": true,
  "description": "Eight-world atlas: six complete campaigns, six Pale Reach assignments and a planned final world. Seventy-two circuit missions plus one bonus; offline and dependency-free.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node tools/build.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:ci": "node --test --test-reporter=./tools/ci-reporter.cjs tests/*.test.cjs",
    "check": "node tools/check.cjs && npm run typecheck",
    "serve": "node tools/serve.cjs",
    "replays:sync": "node tools/sync-replays.cjs",
    "verify:runs": "node tools/verify-island-runs.cjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
